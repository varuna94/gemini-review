__pycache__/
*.pyc

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# graft's Claude Code wiring — generated by `graft init`, per-machine, and this
# repository neither requires nor installs graft. Committing it would configure a
# third-party tool for everyone who clones a public plugin repo, and `graft init`
# rewrites these files anyway, so fixes made here are silently reverted.
# Run `graft init --no-global` to regenerate them locally.
/.claude/
/.mcp.json
